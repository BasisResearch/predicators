#!/bin/bash
#SBATCH -J arc_vid2
#SBATCH -o logs/%A_%a.out
#SBATCH -e logs/%A_%a.err
#SBATCH -N 1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1
#SBATCH --get-user-env
#SBATCH --mem=1500
#SBATCH -t 01:00:00
#SBATCH --partition=ellis,gpu,default_partition
#SBATCH --array=0-5%4

# Replay videos for sweep-2 successes that precede any RL call.
cd /home/wp237/predicators
export PYTHONHASHSEED=0
export OPENBLAS_NUM_THREADS=1
OUT=${1:-$HOME/arc_outputs2/videos}
A=$HOME/arc_outputs2
mkdir -p "$OUT" logs

RUNS=(
  "plug_move_to_seed0:$A/pybullet_plug_outlet/move_to/claude_code/seed_0"
  "plug_no_particles_seed2:$A/pybullet_plug_outlet/no_particles/claude_code/seed_2"
  "donut_move_to_seed2:$A/pybullet_donut/move_to/claude_code/seed_2"
  "donut_no_particles_seed2:$A/pybullet_donut/no_particles/claude_code/seed_2"
  "airport_move_to_seed0:$A/pybullet_airport/move_to/claude_code/seed_0"
  "airport_model_free_seed1:$A/pybullet_airport/model_free/claude_code/seed_1"
)
ENTRY=${RUNS[$SLURM_ARRAY_TASK_ID]}
NAME=${ENTRY%%:*}
DIR=${ENTRY#*:}
echo "task $SLURM_ARRAY_TASK_ID: $NAME <- $DIR"
uv run python -m agent_robot_control.experiments.replay "$DIR" \
    --video "$OUT/$NAME.mp4" --camera 640x360 --fps 30 --stop-at-success
