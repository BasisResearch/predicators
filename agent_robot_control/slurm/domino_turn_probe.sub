#!/bin/bash
#SBATCH -J dom_turn
#SBATCH -o logs/%j.out
#SBATCH -e logs/%j.err
#SBATCH -N 1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=2
#SBATCH --get-user-env
#SBATCH --mem=8000
#SBATCH -t 04:00:00
#SBATCH --partition=ellis,gpu,default_partition

# Generate one L-shaped min-block domino task and describe it. Generation runs
# simulated minimum-block searches (turn attempts survive ~1 in 30), so this is
# slow the first time and cached afterwards.
cd /home/wp237/predicators
export PYTHONHASHSEED=0
export OPENBLAS_NUM_THREADS=1
mkdir -p logs
SEED=${1:-0}
OUT=${2:-$HOME/arc_scratch/domino_turn_seed$SEED.png}
ENV=${3:-domino_turn}
mkdir -p "$(dirname "$OUT")"
CAM=${4:-1280x720}
VIEW=${5:-default}
uv run python -m agent_robot_control.experiments.domino_turn_probe "$SEED" "$OUT" "$ENV" "$CAM" "$VIEW"
