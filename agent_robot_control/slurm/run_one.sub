#!/bin/bash
#SBATCH -J arc_run
#SBATCH -o logs/%j.out
#SBATCH -e logs/%j.err
#SBATCH -N 1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --get-user-env
#SBATCH --mem=32000
#SBATCH -t 24:00:00
#SBATCH --partition=ellis,gpu,default_partition
#SBATCH --requeue

# One agent-robot-control run. Usage:
#   sbatch agent_robot_control/slurm/run_one.sub env=donut condition=model_free seed=0
# All arguments are Hydra overrides.

cd /home/wp237/predicators
export PYTHONHASHSEED=0
export OPENBLAS_NUM_THREADS=1
# API key for the harness: keep it outside the repo.
if [ -f "$HOME/.anthropic_key" ]; then
    export ANTHROPIC_API_KEY="$(cat "$HOME/.anthropic_key")"
fi
export ARC_OUTPUT_ROOT=${ARC_OUTPUT_ROOT:-$HOME/arc_outputs}
mkdir -p logs

if [ -n "$SLURM_JOB_ID" ] && [ -n "$1" ]; then
    scontrol update job="$SLURM_JOB_ID" JobName="arc_$(echo "$@" | tr ' =/' '___')" 2>/dev/null || true
fi

uv run python -m agent_robot_control.experiments.run_experiment "$@"
